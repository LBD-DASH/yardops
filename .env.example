# RootOS Environment Variables
# Copy this file to .env.local and fill in the values

# ===========================================
# SUPABASE (Required)
# ===========================================
# Found in: Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# APP URLS (Required)
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# ===========================================
# PAYMENT PROVIDERS (Optional - for client)
# ===========================================
# Comma-separated list of enabled providers
NEXT_PUBLIC_PAYMENT_PROVIDERS=ozow,payfast,eft

# ===========================================
# DEVELOPMENT NOTES
# ===========================================
# For development, you can use the mock mode in Edge Functions
# No real payment providers needed for local testing

# For production, obtain real keys from:
# - Ozow: https://ozow.com/developers
# - PayFast: https://payfast.co.za/account-info
# - Yoco: https://yoco.com/developers